{
  "name": "jati",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "axe-core": "4.14.0",
    "puppeteer-core": "25.15.0",
    "qrcode": "1.5.4",
    "typescript": "7.0.2"
  },
  "scripts": {
    "test": "tsc -p tsconfig.json --noEmit && tsc -p apps/cek/tsconfig.json --noEmit && pnpm --filter @adindamochamad/jati build && pnpm -r test && pnpm ukuran && node --experimental-strip-types scripts/cek-skema.ts",
    "vektor": "node --experimental-strip-types scripts/tulis-vektor.ts",
    "verifikasi": "node --experimental-strip-types scripts/verifikasi.ts",
    "terbitkan-contoh": "node --experimental-strip-types scripts/terbitkan-contoh.ts",
    "jati": "node --experimental-strip-types packages/jati/bin/jati.ts",
    "cek": "node --experimental-strip-types scripts/sajikan-cek.ts",
    "demo": "node --experimental-strip-types examples/lima-kasus/demo.ts",
    "uji-akses": "node --experimental-strip-types scripts/uji-akses.ts",
    "ukuran": "node --experimental-strip-types scripts/ukuran.ts"
  }
}
